# ─── PostgreSQL (FastAPI + asyncpg) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Your OAuth2 Client ID from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Super Admin Email — the Google account that can create/edit/delete events
# Must exactly match the email returned by Google OAuth for the admin account.
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Optional: token expiry in minutes (default: 10080 = 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── Google Gemini (AI chatbot) ───────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" on your deployment platform.
# In production: Secure cookie flag is enabled, JWT_SECRET_KEY is enforced.
ENVIRONMENT=development

# ─── Backend Port ─────────────────────────────────────────────────────────────
PORT=8000
