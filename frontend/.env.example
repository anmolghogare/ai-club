# Backend API root URL (production)
# Do NOT include a trailing slash or a specific endpoint path
VITE_API_URL=https://ai-club-website-e9zk.onrender.com

# Backend API root URL (local development)
# Used automatically in dev mode by src/lib/api.ts
VITE_DEV_API_URL=http://localhost:8000

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Supabase Configuration
# Get these from: https://app.supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
